+static void cudaee_skip_line (FILE *f)
+{
+    int c;
+    do {
+        c = fgetc (f);
+    } while (c != '\n' && c != EOF);
+}
+
+static int cudaee_read_epoch_hash (const char *fname, char *hash,
+        size_t hash_size)
+{
+    FILE *f = (FILE *) NULL;
+    char key[64];
+    char magic[64];
+    int found = 0;
+    int got_end = 0;
+    int i;
+
+    if (!hash || hash_size < 17) {
+        fprintf (stderr, "cudaee exact price: invalid hash buffer\n");
+        return 1;
+    }
+    hash[0] = '\0';
+
+    f = fopen (fname, "r");
+    if (!f) {
+        perror ("cudaee epoch fopen");
+        return 1;
+    }
+    if (fscanf (f, "%63s", magic) != 1 ||
+        strcmp (magic, "CUDAEE_LP_EPOCH_V1")) {
+        fprintf (stderr, "cudaee exact price: invalid epoch magic\n");
+        fclose (f); return 1;
+    }
+    cudaee_skip_line (f);
+    while (fscanf (f, "%63s", key) == 1) {
+        if (!strcmp (key, "hash")) {
+            if (fscanf (f, "%16s", hash) == 1 && strlen (hash) == 16) {
+                found = 1;
+                for (i = 0; i < 16; i++) {
+                    if (!((hash[i] >= '0' && hash[i] <= '9') ||
+                          (hash[i] >= 'a' && hash[i] <= 'f') ||
+                          (hash[i] >= 'A' && hash[i] <= 'F'))) found = 0;
+                }
+            }
+        } else if (!strcmp (key, "END")) {
+            got_end = 1;
+            cudaee_skip_line (f);
+            break;
+        }
+        cudaee_skip_line (f);
+    }
+    fclose (f);
+    if (!found || !got_end)
+        fprintf (stderr, "cudaee exact price: epoch hash or END missing\n");
+    return found && got_end ? 0 : 1;
+}
+
+static int cudaee_read_solution_dual (const char *fname,
+        const char *expected_hash, int expected_count, double **dual_out)
+{
+    FILE *f = (FILE *) NULL;
+    char key[64];
+    char value[256];
+    char model_hash[64];
+    double *dual = (double *) NULL;
+    int dual_count = -1;
+    int accepted = 0;
+    int optimal = 0;
+    int got_hash = 0;
+    int got_dual = 0;
+    int got_end = 0;
+    int i;
+
+    *dual_out = (double *) NULL;
+    f = fopen (fname, "r");
+    if (!f) {
+        perror ("cudaee solution fopen");
+        return 1;
+    }
+    if (fscanf (f, "%63s", value) != 1 ||
+        strcmp (value, "CUDAEE_LP_SOLUTION_V1")) {
+        fprintf (stderr, "cudaee exact price: invalid solution magic\n");
+        fclose (f); return 1;
+    }
+    cudaee_skip_line (f);
+    while (fscanf (f, "%63s", key) == 1) {
+        if (!strcmp (key, "END")) {
+            got_end = 1;
+            cudaee_skip_line (f);
+            break;
+        } else if (!strcmp (key, "model_hash")) {
+            if (fscanf (f, "%63s", model_hash) == 1) got_hash = 1;
+        } else if (!strcmp (key, "status")) {
+            if (fscanf (f, "%255s", value) == 1 && !strcmp (value, "OPTIMAL"))
+                optimal = 1;
+        } else if (!strcmp (key, "numerically_accepted")) {
+            if (fscanf (f, "%d", &accepted) != 1) accepted = 0;
+        } else if (!strcmp (key, "dual")) {
+            if (fscanf (f, "%d", &dual_count) != 1 ||
+                dual_count != expected_count) {
+                fprintf (stderr, "cudaee exact price: dual row count mismatch\n");
+                fclose (f); return 1;
+            }
+            dual = CC_SAFE_MALLOC (dual_count, double);
+            if (!dual && dual_count) {
+                fprintf (stderr, "cudaee exact price: out of memory\n");
+                fclose (f); return 1;
+            }
+            for (i = 0; i < dual_count; i++) {
+                if (fscanf (f, "%lf", &dual[i]) != 1) {
+                    fprintf (stderr, "cudaee exact price: incomplete dual\n");
+                    CC_IFFREE (dual, double); fclose (f); return 1;
+                }
+            }
+            got_dual = 1;
+        }
+        cudaee_skip_line (f);
+    }
+    fclose (f);
+    if (!got_hash || strcmp (model_hash, expected_hash) || !optimal ||
+        accepted != 1 || !got_dual || !got_end) {
+        fprintf (stderr, "cudaee exact price: solution gate or hash failed\n");
+        CC_IFFREE (dual, double); return 1;
+    }
+    *dual_out = dual;
+    return 0;
+}
+
+int CCtsp_cudaee_exact_price (CCtsp_lp *lp, const char *epoch_fname,
+        const char *solution_fname, const char *certificate_fname,
+        int silent)
+{
+    int rval = 0;
+    int i;
+    int ncount;
+    int cutcount;
+    int dual_count;
+    char model_hash[17];
+    double value;
+    double *dual = (double *) NULL;
+    CCtsp_bigdual *exact = (CCtsp_bigdual *) NULL;
+    CCbigguy bound;
+    FILE *certificate = (FILE *) NULL;
+
+    if (!lp || !epoch_fname || !solution_fname) return 1;
+    ncount = lp->graph.ncount;
+    cutcount = lp->cuts.cutcount;
+    dual_count = ncount + cutcount;
+    rval = cudaee_read_epoch_hash (epoch_fname, model_hash,
+                                    sizeof (model_hash));
+    if (rval) goto CLEANUP;
+    rval = cudaee_read_solution_dual (solution_fname, model_hash,
+                                       dual_count, &dual);
+    if (rval) goto CLEANUP;
+
+    exact = CC_SAFE_MALLOC (1, CCtsp_bigdual);
+    if (!exact) {
+        fprintf (stderr, "cudaee exact price: out of memory\n");
+        rval = 1; goto CLEANUP;
+    }
+    exact->cutcount = cutcount;
+    exact->node_pi = (CCbigguy *) NULL;
+    exact->cut_pi = (CCbigguy *) NULL;
+    exact->node_pi = CC_SAFE_MALLOC (ncount, CCbigguy);
+    if (!exact->node_pi && ncount) {
+        rval = 1; goto CLEANUP;
+    }
+    if (cutcount) {
+        exact->cut_pi = CC_SAFE_MALLOC (cutcount, CCbigguy);
+        if (!exact->cut_pi) {
+            rval = 1; goto CLEANUP;
+        }
+    }
+
+    for (i = 0; i < dual_count; i++) {
+        value = dual[i];
+        if (value != value || value <= -2147483648.0 || value >= 2147483648.0) {
+            fprintf (stderr, "cudaee exact price: dual is NaN/Inf/out of range\n");
+            rval = 1; goto CLEANUP;
+        }
+        if (i >= ncount) {
+            if (lp->cuts.cuts[i-ncount].sense == 'G' && value < 0.0)
+                value = 0.0;
+            else if (lp->cuts.cuts[i-ncount].sense == 'L' && value > 0.0)
+                value = 0.0;
+        }
+        if (i < ncount) exact->node_pi[i] = CCbigguy_dtobigguy (value);
+        else exact->cut_pi[i-ncount] = CCbigguy_dtobigguy (value);
+    }
+
+    CCtsp_free_bigdual (&lp->exact_dual);
+    lp->exact_dual = exact;
+    exact = (CCtsp_bigdual *) NULL;
+    rval = CCtsp_exact_price (lp, &bound, 1, 0, silent);
+    if (rval) {
+        fprintf (stderr, "cudaee complete-graph exact price failed\n");
+        goto CLEANUP;
+    }
+    lp->exact_lowerbound = bound;
+
+    if (certificate_fname && certificate_fname[0]) {
+        certificate = fopen (certificate_fname, "w");
+        if (!certificate) {
+            perror ("cudaee exact certificate fopen");
+            rval = 1; goto CLEANUP;
+        }
+        fprintf (certificate, "CUDAEE_CONCORDE_EXACT_V1\n");
+        fprintf (certificate, "model_hash %s\n", model_hash);
+        fprintf (certificate, "status EXACT_PRICED\n");
+        fprintf (certificate, "complete_graph 1\n");
+        fprintf (certificate, "dual_rows %d\n", dual_count);
+        fprintf (certificate, "exact_lower_bound %.17g\n",
+                 CCbigguy_bigguytod (bound));
+        fprintf (certificate, "upper_bound %.17g\n", lp->upperbound);
+#ifdef CC_BIGGUY_BUILTIN
+        fprintf (certificate, "exact_words %lld\n", (long long) bound);
+#else
+        fprintf (certificate, "exact_words %hu %hu %hu %hu\n",
+                 bound.ihi, bound.ilo, bound.fhi, bound.flo);
+#endif
+        fprintf (certificate, "END\n");
+        if (fclose (certificate)) {
+            perror ("cudaee exact certificate fclose");
+            rval = 1;
+        }
+        certificate = (FILE *) NULL;
+    }
+
+CLEANUP:
+    if (certificate) fclose (certificate);
+    if (exact) CCtsp_free_bigdual (&exact);
+    CC_IFFREE (dual, double);
+    return rval;
+}

+/* cudaEdgeElimination 的 lp-epoch-v1 使用 FNV-1a 绑定模型和列映射。 */
+static void cudaee_hash_bytes (unsigned long long *hash, const void *data,
+        size_t size)
+{
+    const unsigned char *p = (const unsigned char *) data;
+    size_t i;
+
+    for (i = 0; i < size; i++) {
+        *hash ^= (unsigned long long) p[i];
+        *hash *= 1099511628211ULL;
+    }
+}
+
+static void cudaee_hash_int (unsigned long long *hash, int value)
+{
+    cudaee_hash_bytes (hash, (const void *) &value, sizeof (value));
+}
+
+static void cudaee_hash_double (unsigned long long *hash, double value)
+{
+    cudaee_hash_bytes (hash, (const void *) &value, sizeof (value));
+}
+
+static void cudaee_hash_char (unsigned long long *hash, char value)
+{
+    cudaee_hash_bytes (hash, (const void *) &value, sizeof (value));
+}

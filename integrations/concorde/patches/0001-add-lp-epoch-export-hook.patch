+int CClp_dump_lp_epoch (CClp *lp, const char *fname, int edge_count,
+        const int *edge_u, const int *edge_v)
+{
+    int rval = 0;
+    int nrows, ncols, objsense, nnz = 0;
+    int i, j, offset;
+    int *rowcnt = (int *) NULL;
+    int *rowbeg = (int *) NULL;
+    int *rowind = (int *) NULL;
+    double *rowval = (double *) NULL;
+    double *rhs = (double *) NULL;
+    char *sense = (char *) NULL;
+    double *obj = (double *) NULL;
+    double *lower = (double *) NULL;
+    double *upper = (double *) NULL;
+    FILE *out = (FILE *) NULL;
+    unsigned long long hash = 14695981039346656037ULL;
+    double objective_offset = 0.0;
+    char variable_type = 'C';
+
+    if (!lp || !lp->p || !fname || !fname[0]) {
+        fprintf (stderr, "CClp_dump_lp_epoch: invalid argument\n");
+        return 1;
+    }
+    nrows = QSget_rowcount (lp->p);
+    ncols = QSget_colcount (lp->p);
+    if (nrows < 0 || ncols < 0 || edge_count != ncols || !edge_u || !edge_v) {
+        fprintf (stderr, "CClp_dump_lp_epoch: column-edge map mismatch\n");
+        return 1;
+    }
+    rval = QSget_objsense (lp->p, &objsense);
+    if (rval || objsense != QS_MIN) {
+        fprintf (stderr, "CClp_dump_lp_epoch: only minimization is supported\n");
+        rval = 1; goto CLEANUP;
+    }
+    obj = CC_SAFE_MALLOC (ncols, double);
+    lower = CC_SAFE_MALLOC (ncols, double);
+    upper = CC_SAFE_MALLOC (ncols, double);
+    if ((!obj && ncols) || (!lower && ncols) || (!upper && ncols)) {
+        fprintf (stderr, "CClp_dump_lp_epoch: out of memory\n");
+        rval = 1; goto CLEANUP;
+    }
+    rval = QSget_obj (lp->p, obj);
+    if (rval) {
+        fprintf (stderr, "CClp_dump_lp_epoch: QSget_obj failed\n");
+        goto CLEANUP;
+    }
+    rval = QSget_bounds (lp->p, lower, upper);
+    if (rval) {
+        fprintf (stderr, "CClp_dump_lp_epoch: QSget_bounds failed\n");
+        goto CLEANUP;
+    }
+    rval = QSget_rows (lp->p, &rowcnt, &rowbeg, &rowind, &rowval,
+                       &rhs, &sense, (char ***) NULL);
+    if (rval) {
+        fprintf (stderr, "CClp_dump_lp_epoch: QSget_rows failed\n");
+        goto CLEANUP;
+    }
+    for (i = 0; i < nrows; i++) nnz += rowcnt[i];
+
+    out = fopen (fname, "w");
+    if (!out) {
+        perror ("CClp_dump_lp_epoch fopen");
+        rval = 1; goto CLEANUP;
+    }
+    fprintf (out, "CUDAEE_LP_EPOCH_V1\n");
+    fprintf (out, "rows %d\n", nrows);
+    fprintf (out, "columns %d\n", ncols);
+    fprintf (out, "objective_sense %d\n", objsense);
+    fprintf (out, "objective_offset %.17g\n", objective_offset);
+
+    fprintf (out, "objective %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " %.17g", obj[i]);
+    fprintf (out, "\n");
+
+    fprintf (out, "row_offsets %d", nrows + 1);
+    offset = 0;
+    for (i = 0; i < nrows; i++) {
+        fprintf (out, " %d", offset);
+        offset += rowcnt[i];
+    }
+    fprintf (out, " %d\n", offset);
+
+    fprintf (out, "column_indices %d", nnz);
+    for (i = 0; i < nrows; i++) {
+        for (j = 0; j < rowcnt[i]; j++) {
+            fprintf (out, " %d", rowind[rowbeg[i] + j]);
+        }
+    }
+    fprintf (out, "\n");
+
+    fprintf (out, "values %d", nnz);
+    for (i = 0; i < nrows; i++) {
+        for (j = 0; j < rowcnt[i]; j++) {
+            fprintf (out, " %.17g", rowval[rowbeg[i] + j]);
+        }
+    }
+    fprintf (out, "\n");
+
+    fprintf (out, "senses %d", nrows);
+    for (i = 0; i < nrows; i++) fprintf (out, " %c", sense[i]);
+    fprintf (out, "\n");
+    fprintf (out, "rhs %d", nrows);
+    for (i = 0; i < nrows; i++) fprintf (out, " %.17g", rhs[i]);
+    fprintf (out, "\n");
+    fprintf (out, "lower_bounds %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " %.17g", lower[i]);
+    fprintf (out, "\n");
+    fprintf (out, "upper_bounds %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " %.17g", upper[i]);
+    fprintf (out, "\n");
+    fprintf (out, "variable_types %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " C");
+    fprintf (out, "\n");
+    fprintf (out, "edge_u %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " %d", edge_u[i]);
+    fprintf (out, "\n");
+    fprintf (out, "edge_v %d", ncols);
+    for (i = 0; i < ncols; i++) fprintf (out, " %d", edge_v[i]);
+    fprintf (out, "\n");
+
+    cudaee_hash_int (&hash, nrows);
+    cudaee_hash_int (&hash, ncols);
+    cudaee_hash_int (&hash, objsense);
+    cudaee_hash_double (&hash, objective_offset);
+    for (i = 0; i < ncols; i++) cudaee_hash_double (&hash, obj[i]);
+    offset = 0;
+    for (i = 0; i < nrows; i++) {
+        cudaee_hash_int (&hash, offset); offset += rowcnt[i];
+    }
+    cudaee_hash_int (&hash, offset);
+    for (i = 0; i < nrows; i++) {
+        for (j = 0; j < rowcnt[i]; j++)
+            cudaee_hash_int (&hash, rowind[rowbeg[i] + j]);
+    }
+    for (i = 0; i < nrows; i++) {
+        for (j = 0; j < rowcnt[i]; j++)
+            cudaee_hash_double (&hash, rowval[rowbeg[i] + j]);
+    }
+    for (i = 0; i < nrows; i++) cudaee_hash_char (&hash, sense[i]);
+    for (i = 0; i < nrows; i++) cudaee_hash_double (&hash, rhs[i]);
+    for (i = 0; i < ncols; i++) cudaee_hash_double (&hash, lower[i]);
+    for (i = 0; i < ncols; i++) cudaee_hash_double (&hash, upper[i]);
+    for (i = 0; i < ncols; i++) cudaee_hash_char (&hash, variable_type);
+    for (i = 0; i < ncols; i++) cudaee_hash_int (&hash, edge_u[i]);
+    for (i = 0; i < ncols; i++) cudaee_hash_int (&hash, edge_v[i]);
+    fprintf (out, "hash %016llx\n", hash);
+    fprintf (out, "END\n");
+    if (fclose (out)) {
+        perror ("CClp_dump_lp_epoch fclose");
+        rval = 1;
+    }
+    out = (FILE *) NULL;
+
+CLEANUP:
+    if (out) fclose (out);
+    CC_IFFREE (obj, double);
+    CC_IFFREE (lower, double);
+    CC_IFFREE (upper, double);
+    if (rowcnt) QSfree (rowcnt);
+    if (rowbeg) QSfree (rowbeg);
+    if (rowind) QSfree (rowind);
+    if (rowval) QSfree (rowval);
+    if (rhs) QSfree (rhs);
+    if (sense) QSfree (sense);
+    return rval;
+}

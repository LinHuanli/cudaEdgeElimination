{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CUDAEE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUDAEE_ENABLE_CUDA": "OFF",
        "CUDAEE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "cpu-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUDAEE_ENABLE_CUDA": "OFF",
        "CUDAEE_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "cuda-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUDAEE_ENABLE_CUDA": "ON",
        "CUDAEE_ENABLE_SANITIZERS": "OFF",
        "CUDAEE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "cuda-sm86-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-sm86-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUDAEE_ENABLE_CUDA": "ON",
        "CUDAEE_ENABLE_SANITIZERS": "OFF",
        "CUDAEE_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "cuda-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUDAEE_ENABLE_CUDA": "ON",
        "CUDAEE_ENABLE_SANITIZERS": "OFF",
        "CUDAEE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "cuda-sm86-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-sm86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUDAEE_ENABLE_CUDA": "ON",
        "CUDAEE_ENABLE_SANITIZERS": "OFF",
        "CUDAEE_CUDA_ARCHITECTURES": "86"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "cuda-release", "configurePreset": "cuda-release" },
    { "name": "cuda-sm86-release", "configurePreset": "cuda-sm86-release" },
    { "name": "cuda-debug", "configurePreset": "cuda-debug" },
    { "name": "cuda-sm86-debug", "configurePreset": "cuda-sm86-debug" }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": { "outputOnFailure": true },
      "environment": { "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1" }
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cuda-sm86-release",
      "configurePreset": "cuda-sm86-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
